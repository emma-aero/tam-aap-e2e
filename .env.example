# Copy to .env (git-ignored) and fill in. Never commit real credentials.
# Only dev is allowed: the suite refuses to run against any other host.
E2E_BASE_URL=https://dev.airportacumen.emma.aero

# A normal portal user
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# A user with the requests:admin role (reviews/approves requests)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Opt-in only (default off):
# 1 = tests may create requests WITH a domain, which emails every committee member of that domain
E2E_ALLOW_COMMITTEE_EMAILS=0
# 1 = admin tests may APPROVE requests, which writes to (and then cleans up in) dev DataHub
E2E_ALLOW_DATAHUB_WRITES=0
